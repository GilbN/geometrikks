# GeoMetrikks configuration — the short list. Full reference: docs/configuration.md

# Login for the web UI (required unless APP_AUTH_DISABLED=true)
APP_ADMIN_USER=admin
APP_ADMIN_PASSWORD=

# Set true ONLY behind an authenticating reverse proxy (Authelia, Tailscale...)
APP_AUTH_DISABLED=false

# MaxMind GeoLite2 auto-download (free account: maxmind.com/en/geolite2/signup)
MAXMINDDB_USER_ID=
MAXMINDDB_LICENSE_KEY=

# Nginx access log(s) to tail — a single path or JSON list.
# The compose file mounts $NGINX_LOG_DIR (default /var/log/nginx) read-only.
LOGPARSER_LOG_PATHS=/var/log/nginx/access.log

# Hostname label attached to ingested events
LOGPARSER_HOST_NAME=my-server

# Database password (used by both containers; change from the default)
DB_PASSWORD=geopass
