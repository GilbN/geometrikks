# syntax=docker/dockerfile:1

FROM oven/bun:1.4.4-slim@sha256:1846adf22496bd711036aae8be147e57bdebbaea2e5264e3e0b5af1db187d9a4 AS bun

FROM ghcr.io/astral-sh/uv:python3.13-bookworm-slim

ARG APP_IMAGE_TAG=local
ARG GEOMETRIKKS_VERSION=0.0.0+local

COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun

WORKDIR /app

# Enable bytecode compilation
ENV UV_COMPILE_BYTECODE=1 \
    PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    APP_ENVIRONMENT=development \
    APP_RUNTIME=container \
    APP_IMAGE_TAG=${APP_IMAGE_TAG} \
    API_RELOAD=true \
    VITE_DEV_MODE=true

COPY pyproject.toml uv.lock* README.md ./
COPY package.json bun.lock ./

# Install the project once so importlib.metadata can report its version. The
# source mount used for hot reload replaces this copy at runtime.
COPY geometrikks/ ./geometrikks/

# Dependencies install first, without the pretend version, so a dependency
# built from an sdist with setuptools-scm doesn't pick it up.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project

# The wheel metadata keeps the pretend version verbatim, so a tag like
# v0.22.0-dev.4 has to be written in PEP 440 form here. Without .git uv's
# build cache is keyed on pyproject.toml alone, so --refresh-package stops a
# cached build from an earlier version being reused.
RUN --mount=type=cache,target=/root/.cache/uv \
    SETUPTOOLS_SCM_PRETEND_VERSION="$(printf '%s' "${GEOMETRIKKS_VERSION}" | sed -e 's/^v//' -e 's/-dev\./.dev/')" uv sync --frozen --refresh-package geometrikks

RUN --mount=type=cache,target=/root/.bun \
    bun install --frozen-lockfile

COPY vite.config.ts tsconfig.json components.json index.html openapi-ts.config.ts ./
COPY resources/ ./resources/
COPY alembic.ini ./
COPY migrations/ ./migrations/

RUN mkdir -p /app/data/geoip

# Note: Source code is mounted as volumes in docker-compose
# This allows hot-reload to work

STOPSIGNAL SIGTERM
EXPOSE 8000

# Default command runs backend with reload
# Frontend can be run separately or via docker-compose
CMD ["litestar", "--app", "geometrikks.server.core:create_app", "run", "--host", "0.0.0.0", "--port", "8000", "--reload", "--debug"]
