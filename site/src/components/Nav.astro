---
import Mark from "./Mark.astro";
import Wordmark from "./Wordmark.astro";
---

<nav>
  <div class="wrap">
    <a class="brand" href="/" aria-label="GeoMetrikks home">
      <Mark size={28} class="mark" />
      <Wordmark class="text-[16px]" />
    </a>
    <ul>
      <li><a href="#sources">Sources</a></li>
      <li><a href="#screens">Screens</a></li>
      <li><a href="#crowdsec">CrowdSec</a></li>
      <li><a href="#agents">Agents</a></li>
      <li><a href="#install">Install</a></li>
      <li><a href="/docs/get-started/quickstart/">Docs</a></li>
    </ul>
    <a class="btn" href="https://github.com/GilbN/geometrikks">
      <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"
        ><path
          d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
        ></path></svg
      >
      GitHub
    </a>
  </div>
</nav>

<style>
  nav {
    position: sticky;
    top: 0;
    z-index: 10;
    backdrop-filter: blur(12px);
    background: oklch(0.13 0.025 245 / 75%);
    border-bottom: 1px solid var(--line);
  }
  nav .wrap {
    display: flex;
    align-items: center;
    gap: 28px;
    height: 64px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--fg);
  }
  ul {
    display: flex;
    gap: 22px;
    list-style: none;
    margin: 0 0 0 auto;
    padding: 0;
    font-size: 14px;
    color: var(--fg-dim);
  }
  ul a:hover {
    color: var(--fg);
  }
  @media (max-width: 900px) {
    ul {
      display: none;
    }
    .btn {
      margin-left: auto;
    }
  }
</style>
