---
import Mark from "./Mark.astro";
import Wordmark from "./Wordmark.astro";
---

<nav>
  <div class="wrap">
    <a class="brand" href="/" aria-label="GeoMetrikks home">
      <Mark size={28} class="mark" />
      <Wordmark class="text-[16px]" />
    </a>
    <ul id="site-menu">
      <li><a href="#sources">Sources</a></li>
      <li><a href="#screens">Map and logs</a></li>
      <li><a href="#crowdsec">CrowdSec</a></li>
      <li><a href="#agents">Agents</a></li>
      <li><a href="#install">Install</a></li>
      <li><a href="/docs/get-started/quickstart/">Docs</a></li>
    </ul>
    <a class="btn" href="https://github.com/GilbN/geometrikks">
      <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"
        ><path
          d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
        ></path></svg
      >
      GitHub
    </a>
    <button class="menu" type="button" aria-expanded="false" aria-controls="site-menu" aria-label="Menu">
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
        <path class="bars" d="M2 4h12M2 8h12M2 12h12" />
        <path class="cross" d="M3 3l10 10M13 3L3 13" />
      </svg>
    </button>
  </div>
</nav>

<style>
  nav {
    position: sticky;
    top: 0;
    z-index: 10;
    backdrop-filter: blur(12px);
    background: oklch(0.13 0.025 245 / 75%);
    border-bottom: 1px solid var(--line);
  }
  nav .wrap {
    display: flex;
    align-items: center;
    gap: 28px;
    height: 64px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--fg);
  }
  ul {
    display: flex;
    gap: 22px;
    list-style: none;
    margin: 0 0 0 auto;
    padding: 0;
    font-size: 14px;
    color: var(--fg-dim);
  }
  ul a:hover {
    color: var(--fg);
  }
  .menu {
    display: none;
    width: 40px;
    height: 40px;
    place-items: center;
    border-radius: 8px;
    border: 1px solid var(--line-strong);
    background: transparent;
    color: var(--fg);
    cursor: pointer;
  }
  .menu svg {
    width: 18px;
    height: 18px;
  }
  .menu .cross,
  .menu[aria-expanded="true"] .bars {
    display: none;
  }
  .menu[aria-expanded="true"] .cross {
    display: block;
  }
  @media (max-width: 900px) {
    nav .wrap {
      gap: 12px;
    }
    ul {
      display: none;
    }
    nav[data-open] ul {
      display: flex;
      flex-direction: column;
      gap: 0;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      margin: 0;
      padding: 8px 24px 16px;
      font-size: 16px;
      background: oklch(0.13 0.025 245 / 96%);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--line);
    }
    nav[data-open] ul a {
      display: block;
      padding: 12px 0;
      border-top: 1px solid var(--line);
    }
    .btn {
      margin-left: auto;
    }
    .menu {
      display: grid;
    }
  }
  /* Without scripting the toggle is inert, so the links wrap under the bar. */
  @media (max-width: 900px) and (scripting: none) {
    nav .wrap {
      flex-wrap: wrap;
      height: auto;
      padding-top: 12px;
      padding-bottom: 12px;
    }
    ul {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 18px;
      width: 100%;
      margin: 0;
      order: 1;
    }
    .menu {
      display: none;
    }
  }
</style>

<script>
  const nav = document.querySelector("nav");
  const button = nav?.querySelector<HTMLButtonElement>("button.menu");
  if (nav && button) {
    const set = (open: boolean) => {
      nav.toggleAttribute("data-open", open);
      button.setAttribute("aria-expanded", String(open));
    };
    button.addEventListener("click", () => set(!nav.hasAttribute("data-open")));
    nav.querySelectorAll("#site-menu a").forEach((a) => a.addEventListener("click", () => set(false)));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") set(false);
    });
    matchMedia("(min-width: 901px)").addEventListener("change", (e) => {
      if (e.matches) set(false);
    });
  }
</script>
