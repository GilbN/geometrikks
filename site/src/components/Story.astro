---
// Four chapters beside one sticky screenshot that swaps as chapters pass.
// Screenshots come from data/screenshots via sync-content.mjs.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

const shots = import.meta.glob<{ default: ImageMetadata }>("../assets/screenshots/*.png", { eager: true });
const shot = (name: string) => {
  const hit = shots[`../assets/screenshots/${name}`];
  if (!hit) throw new Error(`Missing screenshot ${name}; run sync-content`);
  return hit.default;
};

const chapters = [
  {
    label: "Map",
    title: "Every request, within seconds, where it came from.",
    body: "Markers, clusters or a heatmap; flat or globe. Routes fly to your home beacon, one per site when you have several. Click a marker for the request, the city and the network behind it.",
    img: "live.png",
    alt: "The live map with markers across Europe, a live request feed and a home beacon in Norway",
  },
  {
    label: "Analytics",
    title: "Which networks, not just which countries.",
    body: "Request volume, status mix, latency percentiles and bytes. Top URLs per host, top user agents, and a Top ASNs view that shows how much of your traffic is hosting providers rather than people.",
    img: "analytics.png",
    alt: "Analytics page with request, status, bandwidth and latency charts",
  },
  {
    label: "Logs",
    title: "The history behind every marker.",
    body: "A searchable, server-paginated record of every request, with a live tail. Geo logs group it by place. Debug logs show the raw lines that failed to parse, linked to their request.",
    img: "access-logs.png",
    alt: "Access logs table with filters and a selected request",
  },
  {
    label: "CrowdSec",
    title: "Bans next to the traffic that caused them.",
    body: "Connect the Local API and see who is banned and whether they are still knocking. Ban or unban any IP from the map, the tables or the IP inspector. Badges update live from the decision stream.",
    img: "crowdsec.png",
    alt: "Security page listing active CrowdSec decisions",
  },
];
---

<section class="story" id="story">
  <div class="wrap">
    <div class="steps">
      {
        chapters.map((c, i) => (
          <div class:list={["step", { on: i === 0 }]} data-img={i}>
            <span class="mono kicker">{c.label}</span>
            <h2 class="section-title">{c.title}</h2>
            <p>{c.body}</p>
          </div>
        ))
      }
    </div>
    <div class="sticky">
      <div class="stack">
        {
          chapters.map((c, i) => (
            <Image
              class={i === 0 ? "on" : undefined}
              src={shot(c.img)}
              widths={[720, 1200, 1912]}
              sizes="(max-width: 900px) 100vw, 60vw"
              format="webp"
              alt={c.alt}
              loading={i === 0 ? "eager" : "lazy"}
            />
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .story {
    padding: 80px 0 120px;
  }
  .story .wrap {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 64px;
    align-items: start;
  }
  .steps {
    display: flex;
    flex-direction: column;
  }
  .step {
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    opacity: 0.35;
    transition: opacity 0.4s;
  }
  .step.on {
    opacity: 1;
  }
  .step p {
    color: var(--fg-dim);
    margin: 0;
    max-width: 42ch;
  }
  .kicker {
    font-size: 13px;
    color: var(--accent);
    display: block;
    margin-bottom: 14px;
  }
  .sticky {
    position: sticky;
    top: 10vh;
  }
  .stack {
    position: relative;
    aspect-ratio: 1912 / 1034;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid oklch(1 0 0 / 14%);
    box-shadow: 0 40px 120px oklch(0 0 0 / 50%);
    background: var(--bg-2);
  }
  .stack img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.5s;
  }
  .stack img.on {
    opacity: 1;
  }
  @media (scripting: none) {
    .step {
      opacity: 1;
    }
  }
  @media (max-width: 900px) {
    .story {
      padding: 64px 0;
    }
    .story .wrap {
      grid-template-columns: 1fr;
    }
    .sticky {
      position: static;
      order: -1;
    }
    .step {
      min-height: 0;
      padding: 32px 0;
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .step,
    .stack img {
      transition: none;
    }
  }
</style>

<script>
  const imgs = document.querySelectorAll<HTMLElement>(".stack img");
  const steps = document.querySelectorAll<HTMLElement>(".step");
  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        const active = e.target as HTMLElement;
        steps.forEach((s) => s.classList.toggle("on", s === active));
        imgs.forEach((im, k) => im.classList.toggle("on", String(k) === active.dataset.img));
      }),
    { rootMargin: "-45% 0px -45% 0px" },
  );
  steps.forEach((s) => io.observe(s));
</script>
